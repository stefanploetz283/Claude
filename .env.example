DATABASE_URL="postgresql://user:password@localhost:5432/fallverwaltung?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# S3-kompatibler Speicher (z.B. Scalingo Cellar Addon) - für Dokumente & Fachbox
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional: initialer Admin-Account für "npm run prisma:seed"
SEED_ADMIN_EMAIL="admin@praxis.de"
SEED_ADMIN_PASSWORD="ÄndernSie123!"
