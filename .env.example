DATABASE_URL="postgresql://user:password@localhost:5432/fallverwaltung?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# In Produktion hinter einem Reverse Proxy (z.B. auf Scalingo) erforderlich:
AUTH_TRUST_HOST="true"

# S3-kompatibler Objektspeicher (z.B. OVHcloud, Scaleway, AWS S3) - für Dokumente & Fachbox
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional: initialer Admin-Account für "npm run prisma:seed"
SEED_ADMIN_EMAIL="admin@praxis.de"
SEED_ADMIN_PASSWORD="ÄndernSie123!"

# Anthropic API-Key für die Sprachdokumentation (console.anthropic.com) - serverseitig, nie im Frontend verwenden
ANTHROPIC_API_KEY=""
