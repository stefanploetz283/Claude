// Datenmodell für die Fallverwaltungs-App einer sozialpädagogischen Praxis

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Benutzer & Auth ----------

enum Role {
  ADMIN
  EMPLOYEE
  VERWALTUNG // Büro/Abrechnung (nicht zu verwechseln mit ActivityType.VERWALTUNG bei der Zeiterfassung)
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  role              Role     @default(EMPLOYEE)
  active            Boolean  @default(true) // Deaktivieren statt Löschen (Datenschutz)

  totpSecret        String? // aktiver, bestätigter TOTP-Secret
  totpSecretPending String? // Secret während des Ersteinrichtungsvorgangs
  totpEnabled       Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedCases     Case[]            @relation("AssignedEmployee")
  substituteCases   Case[]            @relation("SubstituteEmployee")
  caseStatusChanges CaseStatusHistory[]
  serviceEntries    ServiceEntry[]
  timeEntries       TimeEntry[]
  absences          Absence[]
  appointments      Appointment[]     @relation("AppointmentOrganizer")
  uploadedDocuments Document[]
  employeeDocuments EmployeeDocument[]
  uploadedEmployeeDocuments EmployeeDocument[] @relation("EmployeeDocumentUploadedBy")
  knowledgeItems    KnowledgeItem[]
  accessLogs        AccessLog[]
  issuedInvoices    Invoice[]
  createdWaitlistEntries WaitlistEntry[]
  submittedApprovals MonthlyApproval[] @relation("ApprovalSubmittedBy")
  reviewedApprovals  MonthlyApproval[] @relation("ApprovalReviewedBy")
  gutscheinAuswahlen GutscheinAuswahl[]
  bonusPayouts       QuarterlyBonusPayout[]
  paidOutBonuses     QuarterlyBonusPayout[] @relation("BonusPaidOutBy")

  sentMessages      Message[]
  messageRecipients MessageRecipient[]

  weeklyContractHours Decimal?   @db.Decimal(5, 2) // Vertragsstunden/Woche, für Kapazitätsplanung
  allowedHelpTypes    HelpType[] @relation("EmployeeAllowedHelpTypes") // welche Hilfearten diese Fachkraft bearbeiten darf

  // Stundenmodell-Rechner (Jahresarbeitszeit/August-Vorarbeit)
  weeklyWorkDays   Int?     // Tage/Woche, 4 oder 5
  hireDate         DateTime? @db.Date // Eintrittsdatum
  fondsBasisAtHire Decimal?  @db.Decimal(5, 2) // Bestandsschutz-Snapshot der Fonds-Basis bei Einstellung
  tvoedStufe       String? // z.B. "S8b Stufe 3"

  mitarbeiterPlaene MitarbeiterPlan[]

  // Personalakte-Stammdaten
  address                     String?
  birthday                    DateTime? @db.Date
  emergencyContact            String? // Name + Telefonnummer, Freitext
  fuehrungszeugnisGueltigBis  DateTime? @db.Date // erw. Führungszeugnis nach §72a SGB VIII

  @@index([role])
}

// ---------- Stammdaten ----------

model HelpType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Referenzwerte für Fallanlage und Kapazitätsplanung (Stunden-Budget-Modell)
  defaultDurationWeeks  Int?
  defaultTotalHoursMin  Decimal? @db.Decimal(6, 2)
  defaultTotalHoursMax  Decimal? @db.Decimal(6, 2)

  cases            Case[]
  activityProfiles HelpTypeActivityProfile[]
  allowedForEmployees User[] @relation("EmployeeAllowedHelpTypes")
  waitlistEntries  WaitlistEntry[]
}

// Wochenprofil einer Hilfeart: einzelne Tätigkeitskategorien mit Wochenstunden-Referenzwert.
// Die Summe der hoursPerWeek-Werte ist die für die Kapazitätsplanung maßgebliche Wochenrate eines Falls.
model HelpTypeActivityProfile {
  id           String   @id @default(cuid())
  helpType     HelpType @relation(fields: [helpTypeId], references: [id])
  helpTypeId   String
  activityLabel String  // z.B. "Einzelzeit Kind", "Telefonische Netzwerkarbeit"
  hoursPerWeek Decimal? @db.Decimal(5, 2) // nullable, solange kein verlässlicher Wert bekannt (z.B. Netzwerkarbeit)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceEntries ServiceEntry[]

  @@index([helpTypeId])
}

model Client {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  birthDate    DateTime?
  address      String? // veraltet - siehe street/postalCodeCity; bleibt für Altdatensätze erhalten
  street          String?
  postalCodeCity  String?
  contactInfo  String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cases        Case[]

  @@index([lastName, firstName])
}

// ---------- Fall / Hilfe ----------

enum CaseStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Case {
  id                   String     @id @default(cuid())
  caseNumber           String     @unique // Aktenzeichen/Fallnummer
  authority            String     // zuständiges Jugendamt/Auftraggeber
  authorityStreet          String? // Rechnungsadresse Kostenträger
  authorityPostalCodeCity  String?

  client               Client     @relation(fields: [clientId], references: [id])
  clientId             String

  helpType             HelpType   @relation(fields: [helpTypeId], references: [id])
  helpTypeId            String

  assignedEmployee     User       @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedEmployeeId   String

  substituteEmployee   User?      @relation("SubstituteEmployee", fields: [substituteEmployeeId], references: [id])
  substituteEmployeeId String?

  hoursContingent      Decimal    @db.Decimal(7, 2)
  contingentPeriodMonths Int?     // Zeitraum in Monaten, in dem das Kontingent aufgebraucht werden muss

  stundensatz          Decimal?   @db.Decimal(7, 2) // Umsatz-Cockpit: € je FLS-Std. für diesen Fall - null = Settings.stundensatzBasis

  status               CaseStatus @default(ACTIVE)
  startDate            DateTime   @default(now())
  endDate              DateTime?

  expectedEndDate      DateTime?  // voraussichtliches Enddatum für Kapazitätsplanung (separat vom Stundenkontingent-Zeitraum)
  phaseOutWeeks        Int?       // optionale Auslaufphase: Wochenrate fällt in diesen letzten X Wochen linear auf 0

  helpPlanMeetingDate     DateTime? // Hilfeplangespräch
  extensionDeadline       DateTime? // Verlängerungsantrag Frist
  reminderLeadDays        Int       @default(14) // Vorlaufzeit für Fristen-Erinnerungen

  archived             Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  statusHistory        CaseStatusHistory[]
  serviceEntries       ServiceEntry[]
  timeEntries          TimeEntry[]
  appointments         Appointment[]
  documents            Document[]
  messages             Message[]
  processNotes         MonthlyProcessNote[]
  monthlyApprovals     MonthlyApproval[]
  invoices             Invoice[]
  waitlistOrigin       WaitlistEntry?

  @@index([assignedEmployeeId])
  @@index([substituteEmployeeId])
  @@index([status])
  @@index([helpTypeId])
}

// Rechnung ans Jugendamt/Kostenträger - fortlaufende, lückenlose Nummerierung pro Jahr (steuerrechtliche Anforderung)
model Invoice {
  id           String   @id @default(cuid())
  case         Case     @relation(fields: [caseId], references: [id])
  caseId       String

  number       String   @unique // z.B. "2026-07-001"
  year         Int
  sequence     Int // fortlaufender Zähler innerhalb des Jahres

  periodFrom   DateTime
  periodTo     DateTime
  hours        Decimal  @db.Decimal(7, 2)
  hourlyRate   Decimal  @db.Decimal(7, 2)
  totalAmount  Decimal  @db.Decimal(10, 2)

  issuedBy     User     @relation(fields: [issuedById], references: [id])
  issuedById   String
  issuedAt     DateTime @default(now())

  @@unique([caseId, periodFrom, periodTo])
  @@unique([year, sequence])
  @@index([caseId])
}

enum WaitlistStatus {
  WAITING
  CONVERTED // in einen festen Fall umgewandelt
  CANCELLED // Anfrage zurückgezogen o.ä.
}

// Warteliste für Kapazitätsplanung: Anfragen, die noch keinem freien Platz zugeordnet werden konnten.
model WaitlistEntry {
  id          String   @id @default(cuid())
  clientName  String // Name/Fall-Kennung der Anfrage
  authority   String? // anfragendes Jugendamt, optional

  helpType    HelpType @relation(fields: [helpTypeId], references: [id])
  helpTypeId  String

  requestedAt DateTime @default(now()) // Eingangsdatum - Basis für Wartezeit-Sortierung
  urgencyNote String?

  status        WaitlistStatus @default(WAITING)
  matchedCase   Case?          @relation(fields: [matchedCaseId], references: [id])
  matchedCaseId String?        @unique

  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([helpTypeId])
}

model MonthlyProcessNote {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String
  year      Int
  month     Int // 1-12
  text      String
  updatedAt DateTime @updatedAt

  @@unique([caseId, year, month])
  @@index([caseId])
}

enum ApprovalStatus {
  IN_BEARBEITUNG
  WARTET_AUF_FREIGABE
  FREIGEGEBEN
  KORREKTUR_ANGEFORDERT
}

// Freigabe-Workflow für die Leistungsdokumentation eines Falls in einem Abrechnungsmonat.
// Erst ab Status FREIGEGEBEN wird der Zeitraum im Verwaltungsbereich zur Rechnungsstellung sichtbar.
model MonthlyApproval {
  id     String @id @default(cuid())
  case   Case   @relation(fields: [caseId], references: [id])
  caseId String
  year   Int
  month  Int // 1-12

  status ApprovalStatus @default(IN_BEARBEITUNG)

  submittedBy   User?     @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id])
  submittedById String?
  submittedAt   DateTime?

  reviewedBy   User?     @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  correctionNote String? // Pflichtkommentar bei Korrektur-Anforderung, sichtbar für die Fachkraft

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, year, month])
  @@index([caseId])
  @@index([status])
}

model CaseStatusHistory {
  id          String     @id @default(cuid())
  case        Case       @relation(fields: [caseId], references: [id])
  caseId      String
  oldStatus   CaseStatus?
  newStatus   CaseStatus
  reason      String?
  changedBy   User       @relation(fields: [changedById], references: [id])
  changedById String
  changedAt   DateTime   @default(now())

  @@index([caseId])
}

// ---------- Leistungsdokumentation (abrechenbar) ----------

model ServiceEntry {
  id            String   @id @default(cuid())
  case          Case     @relation(fields: [caseId], references: [id])
  caseId        String
  employee      User     @relation(fields: [employeeId], references: [id])
  employeeId    String

  date          DateTime @db.Date
  startTime     DateTime // Uhrzeit (Datum-Anteil irrelevant)
  endTime       DateTime
  durationMinutes Int

  description   String

  // Optionale Zuordnung zu einer Wochenprofil-Kategorie der Hilfeart (z.B. "Telefonische Netzwerkarbeit"),
  // um über die Zeit echte Durchschnittswerte je Kategorie ableiten zu können. Nicht verpflichtend.
  activityProfile   HelpTypeActivityProfile? @relation(fields: [activityProfileId], references: [id])
  activityProfileId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([caseId])
  @@index([employeeId])
  @@index([date])
}

// ---------- Interne Zeiterfassung ----------

enum TimeEntrySource {
  TIMER
  MANUAL
}

enum GeneralActivity {
  VERWALTUNG
  FAHRZEITEN
  SONSTIGES
}

model TimeEntry {
  id              String           @id @default(cuid())
  employee        User             @relation(fields: [employeeId], references: [id])
  employeeId      String

  case            Case?            @relation(fields: [caseId], references: [id])
  caseId          String?
  generalActivity GeneralActivity?

  date            DateTime         @db.Date
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int
  note            String?
  source          TimeEntrySource  @default(MANUAL)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([employeeId])
  @@index([caseId])
  @@index([date])
}

// ---------- Urlaub / Abwesenheit ----------

enum AbsenceType {
  URLAUB
  KRANK
  SONSTIGES
}

model Absence {
  id         String      @id @default(cuid())
  employee   User        @relation(fields: [employeeId], references: [id])
  employeeId String
  type       AbsenceType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  note       String?
  createdAt  DateTime    @default(now())

  @@index([employeeId])
}

// ---------- Terminkalender ----------

model Appointment {
  id                   String   @id @default(cuid())
  title                String
  organizer            User     @relation("AppointmentOrganizer", fields: [organizerId], references: [id])
  organizerId          String
  case                 Case?    @relation(fields: [caseId], references: [id])
  caseId               String?
  startsAt             DateTime
  endsAt               DateTime
  location             String?
  note                 String?
  reminderMinutesBefore Int?    @default(60)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizerId])
  @@index([caseId])
  @@index([startsAt])
}

// ---------- Dokumentenablage pro Fall ----------

model Document {
  id           String   @id @default(cuid())
  case         Case     @relation(fields: [caseId], references: [id])
  caseId       String
  fileName     String
  fileKey      String   // Schlüssel im S3-kompatiblen Speicher
  mimeType     String
  sizeBytes    Int
  category     String?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([caseId])
}

// ---------- Fachbox (Wissensplattform) ----------

enum KnowledgeItemType {
  DOCUMENT
  IMAGE
  LINK
}

model KnowledgeItem {
  id          String            @id @default(cuid())
  title       String
  type        KnowledgeItemType
  description String?
  fileKey     String?           // bei DOCUMENT/IMAGE
  mimeType    String?
  sizeBytes   Int?
  url         String?           // bei LINK
  folder      String?           // Ordnerstruktur (z.B. "Hilfeart/Thema")
  tags        String[]          @default([])

  createdBy   User              @relation(fields: [createdById], references: [id])
  createdById String
  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([folder])
}

// ---------- Team-Kommunikation ----------

model Message {
  id          String              @id @default(cuid())
  sender      User                @relation(fields: [senderId], references: [id])
  senderId    String
  subject     String
  body        String
  isBroadcast Boolean             @default(false)
  case        Case?               @relation(fields: [caseId], references: [id])
  caseId      String?
  createdAt   DateTime            @default(now())

  recipients  MessageRecipient[]

  @@index([senderId])
  @@index([caseId])
}

model MessageRecipient {
  id        String    @id @default(cuid())
  message   Message   @relation(fields: [messageId], references: [id])
  messageId String
  recipient User      @relation(fields: [recipientId], references: [id])
  recipientId String
  readAt    DateTime?

  @@unique([messageId, recipientId])
  @@index([recipientId, readAt])
}

// ---------- Datenschutz: Zugriffsprotokoll ----------

enum AccessAction {
  VIEW
  CREATE
  UPDATE
  ARCHIVE
  DELETE
  EXPORT
  LOGIN
  LOGIN_FAILED
}

model AccessLog {
  id         String       @id @default(cuid())
  user       User?        @relation(fields: [userId], references: [id])
  userId     String?
  action     AccessAction
  entityType String       // z.B. "Case", "Document", "ServiceEntry"
  entityId   String?
  details    String?
  ipAddress  String?
  timestamp  DateTime     @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

// ---------- Praxis-Einstellungen (Singleton) ----------

model Settings {
  id                          String  @id @default("singleton")
  practiceName                String  @default("Praxis für Systemische Entwicklung")
  practiceAddress             String?
  practicePhone                String?
  practiceEmail                String?
  logoUrl                     String?
  colorPrimary                String  @default("#204D4B")
  colorAccentLight             String  @default("#F5F0E8")
  colorTextDark                String  @default("#2E3330")
  hourlyRate                  Decimal? @db.Decimal(7, 2) // Stundensatz für Rechnungen (Praxis-weit einheitlich)

  // Kapazitätsplanung (Stunden-Budget-Modell)
  billableCapacityFactor      Decimal @default(0.75) @db.Decimal(4, 2) // Anteil der Vertragsstunden, der abrechenbar eingeplant wird
  defaultPhaseOutWeeks        Int     @default(5) // Vorbefüllung für Case.phaseOutWeeks
  targetParallelCasesAtFullTime Int   @default(5) // Richtwert, keine harte Grenze

  contingentWarningThreshold  Int     @default(10) // Prozent
  sessionIdleTimeoutMinutes   Int     @default(20)
  employeesCanContributeKnowledge Boolean @default(false)

  // Stundenmodell-Rechner: EINE zentrale Fonds-Basis (%), neue Mitarbeiter übernehmen sie bei Einstellung
  // als eigenen Bestandsschutz-Snapshot (User.fondsBasisAtHire) - kein Mitarbeiter-Wahlrecht.
  aktuelleFondsBasis          Decimal @default(70.28) @db.Decimal(5, 2)

  // Umsatz-Cockpit: hourlyRate (oben) dient bewusst weiter als "Stundensatz Basis" (Vorbelegung für
  // Case.stundensatz, wie schon für Rechnungen genutzt) statt eines zweiten, leicht divergierenden Feldes.
  stundensatzVnb               Decimal @default(115) @db.Decimal(7, 2) // mit verhandelter Vor-/Nachbereitungszeit
  zielFaktor                   Decimal @default(2.2) @db.Decimal(4, 2) // Umsatz ÷ Personalkosten, Zielwert
  mindestFaktorSteuerberater   Decimal @default(2.1) @db.Decimal(4, 2) // struktureller Mindestwert lt. Steuerberater
  breakEvenStundensatz         Decimal @default(56) @db.Decimal(7, 2)
  gesamtkostenJahr             Decimal? @db.Decimal(10, 2) // Personal- + Betriebskosten/Jahr aus der Entgeltkalkulation
  zahlungsverzugTageJugendamt  Int     @default(45) // Erfahrungswert bis Geldeingang nach Rechnungsstellung

  updatedAt                   DateTime @updatedAt
}

// ---------- Bonus-Cockpit ----------

// Praxisweite Schließzeiten (August-Schließung, Weihnachten) - Wochen, die vollständig in einen dieser
// Zeiträume fallen, zählen weder im Kapazitäts- noch im Bonus-Nenner/Zähler als Anwesenheitswochen.
model BetriebsferienPeriod {
  id        String   @id @default(cuid())
  label     String // z.B. "Sommerschließung 2026"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

enum GutscheinAnbieter {
  EDEKA
  DM
  MEDIAMARKT
}

// Monatlicher 50€-Sachbezug nach §8 Abs.2 S.11 EStG - unabhängig von der Quartalsquote, ein Eintrag je
// Mitarbeiter und Kalendermonat.
model GutscheinAuswahl {
  id         String            @id @default(cuid())
  employee   User              @relation(fields: [employeeId], references: [id])
  employeeId String
  year       Int
  month      Int // 1-12
  anbieter   GutscheinAnbieter
  beschafft  Boolean           @default(false) // manuelle Beschaffung/Versand durch die Praxisleitung
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
}

// Markiert, dass der Quartals-Bonus eines Mitarbeiters tatsächlich ausgezahlt wurde (üblicherweise im
// Kalendermonat nach Quartalsende). Quote/Bonusbetrag selbst werden live berechnet, nicht persistiert.
model QuarterlyBonusPayout {
  id         String   @id @default(cuid())
  employee   User     @relation(fields: [employeeId], references: [id])
  employeeId String
  year       Int
  quarter    Int // 1-4
  paidOutAt  DateTime @default(now())
  paidOutBy  User     @relation("BonusPaidOutBy", fields: [paidOutById], references: [id])
  paidOutById String

  @@unique([employeeId, year, quarter])
}

// ---------- Stundenmodell-Rechner ----------

// Katalog datierter Sondertage (Konzeptionstag/Teamtag), die einem oder mehreren Mitarbeiter-Plänen
// zugeordnet werden können - als gemeinsamer Katalog, damit die Team-Gesamtansicht Kollisionen erkennen kann.
model SondertagTyp {
  id                String            @id @default(cuid())
  name              String // z.B. "Konzeptionstag" oder "Teamtag"
  datum             DateTime          @db.Date
  dauerStd          Decimal           @db.Decimal(4, 2)
  istEchterExtraTag Boolean // true = Tag ohne normale Arbeitszeit, false = verlängerter Normaltag
  createdAt         DateTime          @default(now())

  plaene            MitarbeiterPlan[]

  @@index([datum])
}

// Versionierter Arbeitszeit-/Wochenplan eines Mitarbeiters ("Anpassen ab jetzt"): ein neuer Eintrag mit
// gültigAb legt eine neue Version an, ältere Pläne bleiben unverändert als Historie erhalten.
model MitarbeiterPlan {
  id         String   @id @default(cuid())
  employee   User     @relation(fields: [employeeId], references: [id])
  employeeId String
  gueltigAb  DateTime @db.Date

  // Liste von {day: 1-7 (Mo-So), start: "HH:mm", end: "HH:mm"} - bewusst als JSON, da es sich um eine
  // kleine, in sich geschlossene Struktur ohne eigene Abfragebedürfnisse handelt.
  wochenplan Json

  sondertage SondertagTyp[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, gueltigAb])
}

// Personalakte-Dokumente (Lohnabrechnung/Arbeitsvertrag/Führungszeugnis/Sonstiges) - getrennt vom
// fallbezogenen Document-Modell, da hier employeeId statt caseId der Bezugspunkt ist.
model EmployeeDocument {
  id           String   @id @default(cuid())
  employee     User     @relation(fields: [employeeId], references: [id])
  employeeId   String
  fileName     String
  fileKey      String // Schlüssel im S3-kompatiblen Speicher
  mimeType     String
  sizeBytes    Int
  category     String?
  uploadedBy   User     @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([employeeId])
}
